# Smart Link Environment Variables
# Copy this file to .env.local and fill in the values.

# --- Supabase (REQUIRED for production) ---
# Get these from: https://app.supabase.com/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
# Optional: only needed for direct Postgres / Drizzle migration workflows
DATABASE_URL="postgresql://<user>:***@<host>.supabase.co:5432/postgres"

# --- Resend (email confirmations) ---
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# --- Twilio (SMS confirmations) ---
# Get from: https://console.twilio.com
# `TWILIO_ACCOUNT_SID` may be either a classic AC... account SID or an SK... API Key SID when paired with
# `TWILIO_API_ACCOUNT_SID` (derived automatically by `scripts/sync_env.py`).
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_API_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=+123****7890

# --- Telegram owner alerts (OPTIONAL) ---
# Create a bot with @BotFather, then message it once before using the Bot API.
# Required for live owner alerts: bot token + destination chat id.
# Optional: set TELEGRAM_THREAD_ID for a Telegram forum topic inside a group.
TELEGRAM_BOT_TOKEN=123456:your_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_THREAD_ID=

# --- OpenAI (auto-content generation, Phase 4) ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=***

# --- Optional: Sentry (error monitoring) ---
# Get from: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/123456
