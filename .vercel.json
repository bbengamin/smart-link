{
  "builds": [
    {
      "src": "smart-link-app/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "out" }
    }
  ],
  "outputs": [
    {
      "src": "smart-link-app/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "out" }
    }
  ],
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "${SMART_LINK_SUPABASE_URL}",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "${SMART_LINK_SUPABASE_ANON_KEY}",
    "SUPABASE_SERVICE_ROLE_KEY": "${SMART_LINK_SERVICE_ROLE_KEY}",
    "DATABASE_URL": "${SMART_LINK_DATABASE_URL}",
    "TWILIO_ACCOUNT_SID": "${TWILIO_ACCOUNT_SID}",
    "TWILIO_API_KEY": "${TWILIO_API_KEY}",
    "TWILIO_API_SECRET": "${TWILIO_API_SECRET}",
    "TWILIO_PHONE_NUMBER": "${TWILIO_PHONE_NUMBER}",
    "RESEND_API_KEY": "${RESEND_API_KEY}",
    "RESEND_SENDER_FROM": "${RESEND_SENDER_FROM}"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"}
      ]
    }
  ]
}
